# Dirección pública del sitio, SIN barra al final. Se usa para la vista previa al compartir
# el link (og:image en index.html), que necesita URLs absolutas.
# En Vercel NO hace falta tocarla: vite.config.js usa la dirección que da Vercel automáticamente
# (y el dominio propio, cuando se agregue). Este valor solo se usa en builds fuera de Vercel.
# Este archivo es público: no pongas claves ni contraseñas acá (para eso, .env.local).
VITE_SITE_URL=https://saqueyvolea.example
